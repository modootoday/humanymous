{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanymous.dev/schemas/agent-workflow.json",
  "title": "Local agent workflow",
  "type": "object",
  "required": ["id", "version", "phases"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "exit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
          "approval": { "enum": ["none", "required"] },
          "exit": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
