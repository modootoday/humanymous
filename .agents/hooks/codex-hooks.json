{
  "description": "Project safety guard for Codex Auto mode.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agents/hooks/pre-tool-guard.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root 'scripts/agents/hooks/pre-tool-guard.mjs'); exit $LASTEXITCODE\"",
            "timeout": 10,
            "statusMessage": "Checking workspace safety policy"
          }
        ]
      }
    ]
  }
}
