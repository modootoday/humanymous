# Per-Dockerfile ignore (overrides the root .dockerignore) so the Red build can
# see cmd/redteam, cmd/tlsparrot, cmd/gate and the test/ harness.
# Cap=0 context-bloat fix: exclude agent Cargo trees + adapter build caches
# that are not COPY'd into bots (measured 20261110051000 e2e oneshot).
.git
.github
.agent-runs
.agents
.claude
.codex
.gemini
.grok
.cursor
.spec
.spec.local
.specfold
.cache
.tmp
.local-trust
SCRATCH
bin
*.exe
web
docs
sots
plan
crates
skills
adapters
target
target-*
node_modules
**/node_modules
**/.build-cache
test/node_modules
**/*.log
*.md
!THIRD_PARTY_LICENSES.md
.env
*.pem
*.key
.DS_Store
Thumbs.db
