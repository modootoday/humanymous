# Per-Dockerfile ignore (overrides the root .dockerignore) so the Gate build
# can see cmd/gate + internal/. Keep only heavy/irrelevant paths out.
# Cap=0 context-bloat fix: exclude agent Cargo trees + adapter build caches
# that are not needed for gate (measured 20261110051000 e2e oneshot).
.git
.github
.agent-runs
.agents
.claude
.codex
.gemini
.grok
.cursor
.spec
.spec.local
.specfold
.cache
.tmp
.local-trust
SCRATCH
bin
*.exe
web/detector.wasm
docs
sots
plan
crates
skills
adapters
target
target-*
node_modules
**/node_modules
**/.build-cache
test/node_modules
**/*.log
*.md
!THIRD_PARTY_LICENSES.md
.env
*.pem
*.key
.DS_Store
Thumbs.db
