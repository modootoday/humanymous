+#[test]
+fn artifact_ledger_refuses_foreign_stale_duplicate_conflicting_and_escaping_rows() {
+    let (metadata, row, workspace) = artifact_fixture("cef-desktop");
+    let identity = browser_identity(&metadata, &workspace).unwrap();
+    let finish = json!({"reason":"build-finished","success":true});
+    for field in ["package", "manifest", "target", "source", "types", "role", "extra",
+        "test", "fresh", "missing", "duplicate-output", "outside", "parent", "executable"] {
+        let mut bad = row.clone();
+        match field {
+            "package" => bad["package_id"] = json!("other-package"),
+            "manifest" => bad["manifest_path"] = json!(workspace.join("wrong/Cargo.toml")),
+            "target" => bad["target"]["name"] = json!("other-target"),
+            "source" => bad["target"]["src_path"] = json!(workspace.join("wrong/lib.rs")),
+            "types" => bad["target"]["crate_types"] = json!(["cdylib"]),
+            "role" => bad["features"] = json!(["cef-bootstrap"]),
+            "extra" => bad["features"] = json!(["cef-desktop","native-ui","native-pilot-tests"]),
+            "test" => bad["profile"]["test"] = json!(true),
+            "fresh" => bad["fresh"] = json!(true),
+            "missing" => bad["filenames"] = json!([]),
+            "duplicate-output" => bad["filenames"] = json!([row["filenames"][0], row["filenames"][0]]),
+            "outside" => bad["filenames"] = json!([workspace.join("elsewhere/humanymous_browser.dll")]),
+            "parent" => bad["filenames"] = json!([workspace.join("target/../humanymous_browser.dll")]),
+            "executable" => bad["executable"] = json!(workspace.join("target/other.exe")),
+            _ => unreachable!(),
+        }
+        assert!(artifact_ledger(&artifact_bytes(&[bad, finish.clone()]),
+            &identity, "cef-desktop", Some(0)).is_err(), "{field}");
+    }
+    for rows in [
+        vec![row.clone()],
+        vec![row.clone(), json!({"reason":"build-finished","success":false})],
+        vec![row.clone(), row.clone(), finish.clone()],
+        vec![row.clone(), finish.clone(), finish.clone()],
+        vec![finish.clone(), row.clone()],
+        vec![json!({"reason":"compiler-artifact","package_id":"unrelated",
+            "target":{"name":"unrelated"},"filenames":[]}), finish.clone()],
+    ] {
+        assert!(artifact_ledger(&artifact_bytes(&rows), &identity, "cef-desktop", Some(0)).is_err());
+    }
+    let log = artifact_bytes(&[row, finish]);
+    for exit in [None, Some(101)] {
+        assert!(artifact_ledger(&log, &identity, "cef-desktop", exit).is_err());
+    }
+    assert!(artifact_ledger(b"{broken
+", &identity, "cef-desktop", Some(0)).is_err());
+    assert!(artifact_ledger(&vec![b' '; MAX_BYTES + 1],
+        &identity, "cef-desktop", Some(0)).is_err());
+}
