+/// A package ID is opaque: bind the metadata-selected workspace package verbatim.
+pub(super) fn browser_identity(metadata: &Value, workspace: &Path) -> std::io::Result<Value> {
+    let reject = || std::io::Error::other("incompatible Browser Cargo metadata");
+    let manifest = workspace.join("crates/apps/humanymous-browser/Cargo.toml");
+    let source = workspace.join("crates/apps/humanymous-browser/src/lib.rs");
+    if metadata["workspace_root"].as_str().map(Path::new) != Some(workspace) {
+        return Err(reject());
+    }
+    let packages = metadata["packages"].as_array().ok_or_else(reject)?;
+    let selected: Vec<_> = packages.iter().filter(|package| {
+        package["manifest_path"].as_str().map(Path::new) == Some(manifest.as_path())
+            || package["name"] == "humanymous-browser"
+    }).collect();
+    if selected.len() != 1 {
+        return Err(reject());
+    }
+    let package = selected[0];
+    let id = package["id"].as_str().filter(|id| {
+        !id.is_empty() && id.len() <= 4096 && !id.chars().any(char::is_control)
+    }).ok_or_else(reject)?;
+    if package["name"] != "humanymous-browser" || package.get("source") != Some(&Value::Null)
+        || package["manifest_path"].as_str().map(Path::new) != Some(manifest.as_path())
+        || !metadata["workspace_members"].as_array().ok_or_else(reject)?
+            .iter().any(|member| member == id) {
+        return Err(reject());
+    }
+    let targets: Vec<_> = package["targets"].as_array().ok_or_else(reject)?.iter()
+        .filter(|target| target["crate_types"].as_array()
+            .is_some_and(|types| types.iter().any(|kind| kind == "cdylib"))).collect();
+    if targets.len() != 1 {
+        return Err(reject());
+    }
+    let target = targets[0];
+    let types = target["crate_types"].as_array().ok_or_else(reject)?;
+    if target["name"] != "humanymous_browser"
+        || target["src_path"].as_str().map(Path::new) != Some(source.as_path())
+        || target["kind"] != target["crate_types"]
+        || types.len() != 2 || !types.contains(&json!("rlib")) || !types.contains(&json!("cdylib")) {
+        return Err(reject());
+    }
+    let target_directory = metadata["target_directory"].as_str().map(Path::new)
+        .filter(|path| path.is_absolute()).ok_or_else(reject)?;
+    Ok(json!({"package_id":id,"manifest_path":manifest,"target":target,
+        "target_directory":target_directory,
+        "metadata_sha256":format!("{:x}",Sha256::digest(serde_json::to_vec(metadata)?))}))
+}
+
+fn exact_role_features(role: &str, features: &Value) -> bool {
+    let expected = match role {
+        "cef-bootstrap" => vec![json!("cef-bootstrap")],
+        "cef-desktop" => vec![json!("cef-desktop"), json!("native-ui")],
+        _ => return false,
+    };
+    features.as_array().is_some_and(|actual| {
+        actual.len() == expected.len() && expected.iter().all(|feature| actual.contains(feature))
+    })
+}
+
+/// Select only the current role's actual emitted library, never a guessed DLL path.
+pub(super) fn artifact_ledger(
+    bytes: &[u8], identity: &Value, role: &str, exit: Option<i32>,
+) -> std::io::Result<Value> {
+    let reject = || std::io::Error::other("unjoined Browser role Cargo artifact ledger");
+    if bytes.len() > MAX_BYTES || exit != Some(0)
+        || !matches!(role, "cef-bootstrap" | "cef-desktop") {
+        return Err(reject());
+    }
+    let mut selected = None;
+    let mut finished = false;
+    let mut records = 0;
+    for line in bytes.split(|byte| *byte == b'\n') {
+        let line = line.trim_ascii();
+        if line.first() != Some(&b'{') {
+            continue;
+        }
+        records += 1;
+        if finished || records > 65536 || line.len() > MAX_LINE {
+            return Err(reject());
+        }
+        let row = decode_strict_json(line, MAX_LINE).map_err(|_| reject())?;
+        match row["reason"].as_str() {
+            Some("build-finished") => {
+                if row["success"] != true {
+                    return Err(reject());
+                }
+                finished = true;
+            }
+            Some("compiler-message") if row["message"]["level"] == "error" => return Err(reject()),
+            Some("compiler-artifact") => {
+                let is_browser = row["package_id"] == identity["package_id"]
+                    || row["target"]["name"] == "humanymous_browser"
+                    || row["filenames"].as_array().is_some_and(|names| names.iter().any(|name| {
+                        name.as_str().map(Path::new).and_then(Path::file_name)
+                            .is_some_and(|name| name == "humanymous_browser.dll")
+                    }));
+                if !is_browser {
+                    continue;
+                }
+                let expected = &identity["target"];
+                if selected.is_some() || row["package_id"] != identity["package_id"]
+                    || row["manifest_path"] != identity["manifest_path"]
+                    || ["name", "src_path", "crate_types", "kind"].iter()
+                        .any(|key| row["target"][key] != expected[key])
+                    || !exact_role_features(role, &row["features"])
+                    || row["profile"]["test"] != false || row["fresh"] != false
+                    || row.get("executable") != Some(&Value::Null) {
+                    return Err(reject());
+                }
+                let target = identity["target_directory"].as_str().map(Path::new).ok_or_else(reject)?;
+                let names = row["filenames"].as_array().ok_or_else(reject)?;
+                let mut dll = None;
+                for name in names {
+                    let path = name.as_str().map(Path::new).ok_or_else(reject)?;
+                    if !path.is_absolute() || !path.starts_with(target)
+                        || path.components().any(|part| matches!(part,
+                            std::path::Component::ParentDir | std::path::Component::CurDir)) {
+                        return Err(reject());
+                    }
+                    if path.extension().is_some_and(|extension| extension == "dll") {
+                        if dll.is_some() || path.file_name().is_none_or(|name| name != "humanymous_browser.dll") {
+                            return Err(reject());
+                        }
+                        dll = Some(path.to_path_buf());
+                    }
+                }
+                let dll = dll.ok_or_else(reject)?;
+                selected = Some(json!({"role":role,"package_id":identity["package_id"],
+                    "manifest_path":identity["manifest_path"],"target":expected,
+                    "features":row["features"],"profile":row["profile"],"fresh":false,
+                    "filename":dll,"target_directory":target,
+                    "metadata_sha256":identity["metadata_sha256"]}));
+            }
+            Some(_) => {}
+            None => return Err(reject()),
+        }
+    }
+    let mut selected = selected.filter(|_| finished).ok_or_else(reject)?;
+    selected["ledger_sha256"] = json!(format!("{:x}", Sha256::digest(bytes)));
+    selected["build_finished_success"] = json!(true);
+    Ok(selected)
+}
