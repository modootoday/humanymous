+/// Refuse an existing staged file even when its bytes happen to match.
+fn copy_new_verified(source: &Path, destination: &Path) -> io::Result<Value> {
+    let kind = fs::symlink_metadata(source)?.file_type();
+    if kind.is_symlink() || !kind.is_file() {
+        return Err(io::Error::other("native role source is not a regular file"));
+    }
+    let before = digest(source)?;
+    let mut input = fs::File::open(source)?;
+    let expected = input.metadata()?.len();
+    let mut output = fs::OpenOptions::new().write(true).create_new(true).open(destination)?;
+    let copied = io::copy(&mut input, &mut output)?;
+    output.sync_all()?;
+    let after = digest(source)?;
+    let staged = digest(destination)?;
+    if copied != expected || before != after || after != staged {
+        return Err(io::Error::other("native role changed during preservation"));
+    }
+    Ok(serde_json::json!({"sha256":staged,"bytes":copied}))
+}
