+++ b/crates/apps/humanymous-cli/src/qualification/cef_pilot/receipt.rs
@@ -0,0 +1,135 @@
+//! Bounded schema-2 receipt consumer. This is not nativeproof or runtime admission.
+use humanymous_platform::testing::json::decode_strict_json;
+use serde_json::{Value, json};
+use std::{collections::BTreeSet, io};
+
+/// The caller supplies reviewed expectations, never fields copied from the receipt.
+pub(super) struct Expected<'a> {
+    pub source_sha: &'a str,
+    pub source_manifest_sha256: &'a str,
+    pub bootstrap_sha256: &'a str,
+    pub desktop_sha256: &'a str,
+    pub contract: &'a Value,
+}
+
+fn require(ok: bool) -> io::Result<()> {
+    if ok { Ok(()) } else { Err(io::Error::other("CEF schema-2 receipt refused")) }
+}
+
+fn hex(value: &str, length: usize) -> bool {
+    value.len() == length && value.bytes().all(|byte| byte.is_ascii_digit()
+        || (b'a'..=b'f').contains(&byte))
+}
+
+fn exact_keys(value: &Value, keys: &[&str]) -> bool {
+    value.as_object().is_some_and(|object| object.len() == keys.len()
+        && keys.iter().all(|key| object.contains_key(*key)))
+}
+
+fn command(value: &Value) -> io::Result<()> {
+    require(value["status_observed"] == true && value["exit_code"] == 0
+        && value["diagnostic_read_truncated"] == false
+        && value["malformed_json_records"] == 0 && value["oversized_records"] == 0
+        && value["omitted_diagnostics"] == 0)?;
+    let rows = value["diagnostics"].as_array().ok_or_else(|| io::Error::other("CEF diagnostics absent"))?;
+    require(rows.len() <= 64 && rows.iter().all(|row| row["level"] == "warning"))
+}
+
+fn protocol(value: &Value, count: u64) -> io::Result<()> {
+    require(value["required"] == count && value["passed"] == count
+        && value["failed"] == 0 && value["ignored"] == 0
+        && value["filtered"].as_u64().is_some_and(|n| n <= 1_000_000)
+        && value["initializes_cef"] == false && value["starts_processes"] == false)
+}
+
+fn bootstrap_observations(value: &Value, contract: &Value) -> io::Result<()> {
+    require(value["status"] == "complete" && value["observations_complete"] == true
+        && value["read_truncated"] == false && value["full_product_qualified"] == false
+        && value["observed_cases"] == 4 && value["observed_profiles"] == 2)?;
+    let cases = value["cases"].as_array().ok_or_else(|| io::Error::other("CEF cases absent"))?;
+    let required = contract["bootstrap_rejection"]["cases"].as_array()
+        .ok_or_else(|| io::Error::other("CEF contract cases absent"))?;
+    require(cases.len() == 4 && required.len() == 4)?;
+    let mut seen = BTreeSet::new();
+    for case in cases {
+        let id = case["case_id"].as_str().ok_or_else(|| io::Error::other("CEF case id absent"))?;
+        require(required.iter().any(|item| item["id"] == id) && seen.insert(id)
+            && case["spawn_ok"] == true && case["wait_completed"] == true
+            && case["deadline_expired"] == false && case["reaped"] == true
+            && case["exit_code"] == 78
+            && case["spawn_error_kind"] == "none" && case["wait_error_kind"] == "none"
+            && case["cleanup_error_kind"] == "none")?;
+    }
+    let profiles = value["profiles"].as_array().ok_or_else(|| io::Error::other("CEF profiles absent"))?;
+    require(profiles.len() == 2)?;
+    let mut phases = BTreeSet::new();
+    for profile in profiles {
+        let phase = profile["phase"].as_str().ok_or_else(|| io::Error::other("CEF profile phase absent"))?;
+        require(matches!(phase, "before" | "after") && phases.insert(phase)
+            && profile["inventory_ok"] == true && profile["error_kind"] == "none")?;
+        require(if phase == "after" { profile["changed"] == false }
+            else { profile.get("changed") == Some(&Value::Null) })?;
+    }
+    Ok(())
+}
+
+pub(super) fn verify(bytes: &[u8], expected: &Expected<'_>) -> io::Result<Value> {
+    require(hex(expected.source_sha, 40) && hex(expected.source_manifest_sha256, 64)
+        && hex(expected.bootstrap_sha256, 64) && hex(expected.desktop_sha256, 64)
+        && expected.bootstrap_sha256 != expected.desktop_sha256)?;
+    let receipt = decode_strict_json(bytes, 1_048_576).map_err(io::Error::other)?;
+    require(receipt["schema"] == "humanymous.cef-safe-diagnostics/2"
+        && receipt.get("native_build").is_none() && receipt["status"] == "passed"
+        && receipt["stage"] == "complete" && receipt["source_changed"] == false
+        && receipt["source_sha"] == expected.source_sha
+        && receipt["source_manifest_sha256"] == expected.source_manifest_sha256
+        && receipt["browser_ready"] == false && receipt["full_runtime_qualified"] == false
+        && receipt["raw_contents_included"] == false)?;
+    let allowed = ["schema", "stage", "source_sha", "source_manifest_sha256", "native_builds",
+        "role_artifacts", "source_changed", "stage_commands", "status", "protocol_preflight",
+        "bootstrap_rejection_passed", "bootstrap_protocol_preflight", "desktop_passed_tests",
+        "browser_ready", "full_runtime_qualified", "raw_contents_included", "private_report_sha256"];
+    require(receipt.as_object().is_some_and(|object| object.keys()
+        .all(|key| allowed.contains(&key.as_str()))))?;
+    if let Some(value) = receipt.get("private_report_sha256") {
+        require(value.as_str().is_some_and(|value| hex(value, 64)))?;
+    }
+    let roles = ["cef-bootstrap", "cef-desktop"];
+    require(exact_keys(&receipt["native_builds"], &roles)
+        && exact_keys(&receipt["role_artifacts"], &roles))?;
+    for (role, digest) in [(roles[0], expected.bootstrap_sha256), (roles[1], expected.desktop_sha256)] {
+        let stage = format!("native-build-{role}");
+        require(receipt["native_builds"][role] == receipt["stage_commands"][&stage])?;
+        command(&receipt["native_builds"][role])?;
+        let artifact = &receipt["role_artifacts"][role];
+        require(exact_keys(artifact, &["sha256", "bytes"])
+            && artifact["sha256"] == digest && artifact["bytes"].as_u64().is_some_and(|n| n > 0))?;
+    }
+    let stages = ["native-build-cef-bootstrap", "native-build-cef-desktop",
+        "desktop-protocol-build", "desktop-protocol-tests", "bootstrap-protocol-build",
+        "bootstrap-protocol-tests", "bootstrap-rejection", "desktop-process-tests"];
+    require(exact_keys(&receipt["stage_commands"], &stages))?;
+    for stage in stages { command(&receipt["stage_commands"][stage])?; }
+    require(expected.contract["protocol_preflight"]["selector"] == "desktop::pilot_assertions::tests::"
+        && expected.contract["protocol_preflight"]["required_test_count"] == 4
+        && expected.contract["bootstrap_rejection"]["protocol_preflight"]["selector"] == "bootstrap::negative_pilot::tests::"
+        && expected.contract["bootstrap_rejection"]["protocol_preflight"]["required_test_count"] == 3
+        && expected.contract["required_test_count"] == 2)?;
+    protocol(&receipt["protocol_preflight"], 4)?;
+    protocol(&receipt["bootstrap_protocol_preflight"], 3)?;
+    require(receipt["bootstrap_rejection_passed"] == true && receipt["desktop_passed_tests"] == 2)?;
+    let rejection = &receipt["stage_commands"]["bootstrap-rejection"];
+    let outcome = &rejection["test_outcome"];
+    require(outcome["required_case_status"] == "passed" && outcome["executed_tests"] == 1
+        && outcome["passed"] == 1 && outcome["failed"] == 0 && outcome["ignored"] == 0
+        && outcome["filtered"].as_u64().is_some_and(|n| n <= 1_000_000))?;
+    bootstrap_observations(&rejection["bootstrap_observations"], expected.contract)?;
+    Ok(json!({"schema":"humanymous.cef-receipt-consumer/2","source_sha":expected.source_sha,
+        "source_manifest_sha256":expected.source_manifest_sha256,"bounded_receipt_verified":true,
+        "browser_ready":false,"full_runtime_qualified":false,"full_product_qualified":false,
+        "hardware_GPU_qualified":false,"GUI_keyboard_IME_AX_qualified":false}))
+}
+
+#[cfg(test)]
+#[path = "receipt_tests.rs"]
+mod tests;
