+use super::*;
+
+fn reviewed_contract() -> Value {
+    json!({"required_test_count":2,
+        "protocol_preflight":{"selector":"desktop::pilot_assertions::tests::","required_test_count":4},
+        "bootstrap_rejection":{"protocol_preflight":{
+            "selector":"bootstrap::negative_pilot::tests::","required_test_count":3},
+            "cases":[{"id":"no_sandbox"},{"id":"no_sandbox_zero"},
+                {"id":"disable_web_security"},{"id":"disable_gpu_sandbox"}]}})
+}
+
+fn expected(contract: &Value) -> Expected<'_> {
+    Expected { source_sha: "1111111111111111111111111111111111111111",
+        source_manifest_sha256: "2222222222222222222222222222222222222222222222222222222222222222",
+        bootstrap_sha256: "3333333333333333333333333333333333333333333333333333333333333333",
+        desktop_sha256: "4444444444444444444444444444444444444444444444444444444444444444",
+        contract }
+}
+
+fn command_receipt() -> Value {
+    json!({"status_observed":true,"exit_code":0,"diagnostic_read_truncated":false,
+        "malformed_json_records":0,"oversized_records":0,"omitted_diagnostics":0,"diagnostics":[]})
+}
+
+fn protocol_receipt(count: u64) -> Value {
+    json!({"required":count,"passed":count,"failed":0,"ignored":0,"filtered":17,
+        "initializes_cef":false,"starts_processes":false})
+}
+
+fn fixture(expected: &Expected<'_>) -> Value {
+    let mut stages = serde_json::Map::new();
+    for stage in ["native-build-cef-bootstrap", "native-build-cef-desktop",
+        "desktop-protocol-build", "desktop-protocol-tests", "bootstrap-protocol-build",
+        "bootstrap-protocol-tests", "bootstrap-rejection", "desktop-process-tests"] {
+        stages.insert(stage.into(), command_receipt());
+    }
+    let cases: Vec<_> = expected.contract["bootstrap_rejection"]["cases"].as_array().unwrap()
+        .iter().map(|case| json!({"case_id":case["id"],"spawn_ok":true,"wait_completed":true,
+            "deadline_expired":false,"reaped":true,"exit_code":78,"spawn_error_kind":"none",
+            "wait_error_kind":"none","cleanup_error_kind":"none"})).collect();
+    stages["bootstrap-rejection"]["test_outcome"] = json!({"required_case_status":"passed",
+        "executed_tests":1,"passed":1,"failed":0,"ignored":0,"filtered":29});
+    stages["bootstrap-rejection"]["bootstrap_observations"] = json!({"status":"complete",
+        "observations_complete":true,"read_truncated":false,"full_product_qualified":false,
+        "observed_cases":4,"observed_profiles":2,"cases":cases,"profiles":[
+            {"phase":"before","inventory_ok":true,"changed":null,"error_kind":"none"},
+            {"phase":"after","inventory_ok":true,"changed":false,"error_kind":"none"}]});
+    json!({"schema":"humanymous.cef-safe-diagnostics/2","status":"passed","stage":"complete",
+        "source_sha":expected.source_sha,"source_manifest_sha256":expected.source_manifest_sha256,
+        "source_changed":false,"native_builds":{"cef-bootstrap":command_receipt(),
+            "cef-desktop":command_receipt()},"role_artifacts":{
+            "cef-bootstrap":{"sha256":expected.bootstrap_sha256,"bytes":27},
+            "cef-desktop":{"sha256":expected.desktop_sha256,"bytes":53}},
+        "stage_commands":stages,"protocol_preflight":protocol_receipt(4),
+        "bootstrap_protocol_preflight":protocol_receipt(3),"bootstrap_rejection_passed":true,
+        "desktop_passed_tests":2,"browser_ready":false,"full_runtime_qualified":false,
+        "raw_contents_included":false})
+}
+
+#[test]
+fn reviewed_schema_two_receipt_stays_a_bounded_component_result() {
+    let contract = reviewed_contract();
+    let expected = expected(&contract);
+    let summary = verify(&serde_json::to_vec(&fixture(&expected)).unwrap(), &expected).unwrap();
+    assert_eq!(summary["bounded_receipt_verified"], true);
+    for flag in ["browser_ready", "full_runtime_qualified", "full_product_qualified",
+        "hardware_GPU_qualified", "GUI_keyboard_IME_AX_qualified"] {
+        assert_eq!(summary[flag], false);
+    }
+}
+
+#[test]
+fn old_aggregate_missing_role_unreviewed_identity_and_false_pass_are_refused() {
+    let contract = reviewed_contract();
+    let expected = expected(&contract);
+    for change in ["v1", "private-schema", "aggregate", "source", "manifest", "missing-role",
+        "failed-build", "unobserved-build", "artifact", "same-slot", "extra-role", "ignored",
+        "missing-process", "ready", "unknown-stage", "private-field", "failed-status"] {
+        let mut bad = fixture(&expected);
+        match change {
+            "v1" => bad["schema"] = json!("humanymous.cef-safe-diagnostics/1"),
+            "private-schema" => bad["schema"] = json!("humanymous.cef-native-pilot/2"),
+            "aggregate" => bad["native_build"] = command_receipt(),
+            "source" => bad["source_sha"] = json!("a".repeat(40)),
+            "manifest" => bad["source_manifest_sha256"] = json!("a".repeat(64)),
+            "missing-role" => bad["native_builds"]["cef-desktop"] = Value::Null,
+            "failed-build" => bad["native_builds"]["cef-desktop"]["exit_code"] = json!(101),
+            "unobserved-build" => bad["native_builds"]["cef-bootstrap"]["status_observed"] = json!(false),
+            "artifact" => bad["role_artifacts"]["cef-desktop"]["sha256"] = json!("a".repeat(64)),
+            "same-slot" => bad["role_artifacts"]["cef-desktop"]["sha256"] = json!(expected.bootstrap_sha256),
+            "extra-role" => bad["role_artifacts"]["other"] = json!({}),
+            "ignored" => bad["protocol_preflight"]["ignored"] = json!(1),
+            "missing-process" => bad["desktop_passed_tests"] = Value::Null,
+            "ready" => bad["browser_ready"] = json!(true),
+            "unknown-stage" => bad["stage_commands"]["unknown"] = command_receipt(),
+            "private-field" => bad["private_ledger"] = json!("PRIVATE_CANARY"),
+            "failed-status" => bad["status"] = json!("failed"),
+            _ => unreachable!(),
+        }
+        assert!(verify(&serde_json::to_vec(&bad).unwrap(), &expected).is_err(), "{change}");
+    }
+}
+
+#[test]
+fn incomplete_or_duplicated_native_rejection_observations_are_not_success() {
+    let contract = reviewed_contract();
+    let expected = expected(&contract);
+    for change in ["truncated", "unreaped", "deadline", "duplicate", "profile", "cleanup-error", "missing-outcome"] {
+        let mut bad = fixture(&expected);
+        let rejection = &mut bad["stage_commands"]["bootstrap-rejection"];
+        let observations = &mut rejection["bootstrap_observations"];
+        match change {
+            "truncated" => observations["read_truncated"] = json!(true),
+            "unreaped" => observations["cases"][0]["reaped"] = Value::Null,
+            "deadline" => observations["cases"][0]["deadline_expired"] = json!(true),
+            "duplicate" => observations["cases"][1] = observations["cases"][0].clone(),
+            "profile" => observations["profiles"][1]["changed"] = json!(true),
+            "cleanup-error" => observations["cases"][0]["cleanup_error_kind"] = json!("other"),
+            "missing-outcome" => rejection["test_outcome"] = Value::Null,
+            _ => unreachable!(),
+        }
+        assert!(verify(&serde_json::to_vec(&bad).unwrap(), &expected).is_err(), "{change}");
+    }
+}
+
+#[test]
+fn stale_contract_duplicate_json_and_oversized_reports_are_refused() {
+    let mut contract = reviewed_contract();
+    let bytes = serde_json::to_vec(&fixture(&expected(&contract))).unwrap();
+    contract["protocol_preflight"]["selector"] = json!("pilot_assertions::tests::");
+    assert!(verify(&bytes, &expected(&contract)).is_err());
+    let contract = reviewed_contract();
+    let expected = expected(&contract);
+    let duplicate = String::from_utf8(bytes).unwrap().replacen(
+        "\"schema\":", "\"status\":\"passed\",\"schema\":", 1);
+    assert!(verify(duplicate.as_bytes(), &expected).is_err());
+    assert!(verify(&vec![b' '; 1_048_577], &expected).is_err());
+}
