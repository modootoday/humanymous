      "present": true,
      "real": true
    },
    "origin": {
      "binary": "humanymous-runtime-pilot --product-origin (Rust recording origin)",
      "present": true,
      "real": true
    },
    "witnessed_gate": {
      "composition": "humanymous-runtime-pilot --product-gate-witnessed: the humanymous-runtime library ServiceHost::bind_with_witness with require_external_witness=true",
      "present": true,
      "real": "runtime library, lab composition root",
      "why_not_the_shipped_binary": "crates/sdk/humanymous-runtime/src/gateway/main.rs:16 calls ServiceHost::bind(config) only, and crates/cli/src/runtime_host/platform.rs:49 passes no witness on Unix; no shipped executable injects an ExternalWitness"
    }
  },
