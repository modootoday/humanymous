@@ -0,0 +1,234 @@
+//! Apache-only staged artifacts: a merged Cargo package is not a host-role proof.
+#![cfg_attr(not(target_os = "linux"), allow(dead_code))]
+use serde_json::Value;
+
+pub(super) const PRODUCTION: &str =
+    "/opt/httpd/modules/humanymous/apache/2.4.70/x86_64-unknown-linux-gnu/production/humanymous.so";
+pub(super) const PROBE: &str =
+    "/opt/httpd/modules/humanymous/apache/2.4.70/x86_64-unknown-linux-gnu/probe/humanymous.so";
+const ABI: &str = "/opt/httpd/modules/humanymous/apache/2.4.70/x86_64-unknown-linux-gnu/production/apache-abi.json";
+const PATHS: &[(&str, &str)] = &[
+    ("moduleSha256", PRODUCTION),
+    ("probeModuleSha256", PROBE),
+    ("httpdSha256", "/opt/httpd/bin/httpd"),
+    ("abiReceiptSha256", ABI),
+    ("lockSha256", "/opt/httpd/source-Cargo.lock"),
+];
+fn header_lock(lock: &Value) -> Result<(), &'static str> {
+    let required = [
+        "http_request.h",
+        "http_core.h",
+        "httpd.h",
+        "http_config.h",
+        "http_protocol.h",
+        "util_filter.h",
+        "ap_mpm.h",
+        "ap_mmn.h",
+        "apr_pools.h",
+        "apr_tables.h",
+        "apr_buckets.h",
+    ];
+    if lock["schema"] != "humanymous.apache.upstream/0.1"
+        || lock["target"] != "x86_64-unknown-linux-gnu"
+        || lock["httpd"]["version"] != "2.4.70"
+        || lock["apr"]["version"] != "1.7.6"
+        || lock["aprUtil"]["version"] != "1.6.6"
+        || !lock["headers"].as_object().is_some_and(|headers| {
+            headers.len() == required.len()
+                && required.iter().all(|name| {
+                    headers
+                        .get(*name)
+                        .and_then(Value::as_str)
+                        .is_some_and(|hash| {
+                            hash.len() == 64
+                                && hash
+                                    .bytes()
+                                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                        })
+                })
+        })
+    {
+        return Err("apache-header-resource-identity");
+    }
+    Ok(())
+}
+pub(super) fn path<'a>(contract: &'a Value, key: &str) -> Result<&'a str, &'static str> {
+    let expected = PATHS
+        .iter()
+        .find(|(known, _)| *known == key)
+        .ok_or("unknown-apache-artifact")?
+        .1;
+    let actual = contract["artifact_bindings"][key]["path"]
+        .as_str()
+        .ok_or("missing-apache-artifact")?;
+    if actual != expected {
+        return Err("apache-artifact-role-path");
+    }
+    Ok(actual)
+}
+pub(super) fn header_receipt(bytes: &[u8]) -> Result<(), &'static str> {
+    use sha2::{Digest, Sha256};
+    use std::collections::BTreeMap;
+    let receipt: Value = serde_json::from_slice(bytes).map_err(|_| "apache-abi-json")?;
+    if serde_json::to_vec_pretty(&receipt).map_err(|_| "apache-abi-json")? != bytes {
+        return Err("apache-abi-noncanonical");
+    }
+    let lock: Value = serde_json::from_str(include_str!("../../../abi/apache/upstream-lock.json"))
+        .map_err(|_| "apache-header-lock")?;
+    header_lock(&lock)?;
+    let fields = [
+        "schema",
+        "target",
+        "bindgenVersion",
+        "libclangSha256",
+        "clangVersion",
+        "directHeaders",
+        "configuredHeaderClosure",
+        "headerClosureSha256",
+        "bindingsSha256",
+        "fullProductSuccess",
+    ];
+    let object = receipt.as_object().ok_or("apache-abi-object")?;
+    if object.len() != fields.len() || fields.iter().any(|key| !object.contains_key(*key)) {
+        return Err("apache-abi-fields");
+    }
+    if receipt["schema"] != "humanymous.apache.abi-build/0.1"
+        || receipt["target"] != "x86_64-unknown-linux-gnu"
+        || receipt["target"] != lock["target"]
+        || receipt["bindgenVersion"] != "0.73.2"
+        || receipt["fullProductSuccess"] != false
+        || receipt["directHeaders"] != lock["headers"]
+        || !receipt["clangVersion"]
+            .as_str()
+            .is_some_and(|value| !value.is_empty())
+    {
+        return Err("apache-abi-identity");
+    }
+    let digest = |value: &Value| {
+        value.as_str().is_some_and(|s| {
+            s.len() == 64
+                && s.bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        })
+    };
+    for key in ["libclangSha256", "bindingsSha256", "headerClosureSha256"] {
+        if !digest(&receipt[key]) {
+            return Err("apache-abi-digest");
+        }
+    }
+    let closure = receipt["configuredHeaderClosure"]
+        .as_object()
+        .ok_or("apache-abi-closure")?;
+    if closure.is_empty()
+        || closure.iter().any(|(name, hash)| {
+            !name.starts_with('/')
+                || name.contains('\\')
+                || name.split('/').any(|part| part == ".." || part == ".")
+                || !digest(hash)
+        })
+    {
+        return Err("apache-abi-closure");
+    }
+    let sorted: BTreeMap<_, _> = closure
+        .iter()
+        .map(|(name, hash)| (name, hash.as_str().unwrap()))
+        .collect();
+    let hash = format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(&sorted).map_err(|_| "apache-abi-closure")?)
+    );
+    if receipt["headerClosureSha256"] != hash {
+        return Err("apache-abi-closure-binding");
+    }
+    Ok(())
+}
