+            "/opt/httpd/modules/humanymous/apache/2.4.70/aarch64-unknown-linux-gnu/production/humanymous.so",
+            "/opt/httpd/modules/humanymous/apache/2.4.70/x86_64-unknown-linux-gnu/production/../production/humanymous.so",
+        ] {
+            let mut changed = valid.clone();
+            changed["artifact_bindings"]["moduleSha256"]["path"] = wrong.into();
+            assert!(path(&changed, "moduleSha256").is_err(), "{wrong}");
+        }
+        let mut changed = valid.clone();
+        changed["artifact_bindings"]["probeModuleSha256"]["path"] = PRODUCTION.into();
+        assert!(path(&changed, "probeModuleSha256").is_err());
+        assert!(path(&valid, "unknownSha256").is_err());
+    }
+    fn receipt() -> Value {
