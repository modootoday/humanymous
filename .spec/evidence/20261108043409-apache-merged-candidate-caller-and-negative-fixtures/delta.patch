+        let closure = serde_json::json!({"/opt/httpd/include/httpd.h": "a".repeat(64)});
+        let hash = format!(
+            "{:x}",
+            Sha256::digest(serde_json::to_vec(&closure).unwrap())
+        );
+        serde_json::json!({"schema":"humanymous.apache.abi-build/0.1", "target":lock["target"], "bindgenVersion":"0.73.2", "libclangSha256":"b".repeat(64), "clangVersion":"fixture only; not an actual build", "directHeaders":lock["headers"], "configuredHeaderClosure":closure, "headerClosureSha256":hash, "bindingsSha256":"c".repeat(64), "fullProductSuccess":false})
+    }
+    #[test]
+    fn packaged_header_resource_cannot_be_substituted_by_common_native_abi() {
+        let lock: Value =
+            serde_json::from_str(include_str!("../../../abi/apache/upstream-lock.json")).unwrap();
+        assert!(header_lock(&lock).is_ok());
+        for (key, replacement) in [
+            ("schema", serde_json::json!("humanymous.native.abi/1")),
+            ("target", serde_json::json!("aarch64-unknown-linux-gnu")),
+            ("headers", serde_json::json!({})),
+        ] {
+            let mut changed = lock.clone();
+            changed[key] = replacement;
+            assert!(header_lock(&changed).is_err(), "{key}");
+        }
+        let original = receipt();
+        assert!(header_receipt(&serde_json::to_vec_pretty(&original).unwrap()).is_ok());
+        for (key, replacement) in [
+            ("schema", serde_json::json!("humanymous.native.abi/1")),
+            ("target", serde_json::json!("aarch64-unknown-linux-gnu")),
+            ("bindgenVersion", serde_json::json!("0.73.1")),
+            ("directHeaders", serde_json::json!({})),
+            (
+                "configuredHeaderClosure",
+                serde_json::json!({"relative/header.h":"a".repeat(64)}),
+            ),
+            ("headerClosureSha256", serde_json::json!("d".repeat(64))),
+            ("fullProductSuccess", serde_json::json!(true)),
+        ] {
+            let mut changed = original.clone();
+            changed[key] = replacement;
+            assert!(
+                header_receipt(&serde_json::to_vec_pretty(&changed).unwrap()).is_err(),
+                "{key}"
+            );
+        }
+        let mut changed = original.clone();
+        changed["directHeaders"]["httpd.h"] = "d".repeat(64).into();
+        assert!(header_receipt(&serde_json::to_vec_pretty(&changed).unwrap()).is_err());
+        let mut changed = original.clone();
+        changed["unexpected"] = true.into();
+        assert!(header_receipt(&serde_json::to_vec_pretty(&changed).unwrap()).is_err());
+        let mut bytes = serde_json::to_vec_pretty(&original).unwrap();
+        bytes.extend_from_slice(b"{}");
+        assert!(header_receipt(&bytes).is_err());
+    }
