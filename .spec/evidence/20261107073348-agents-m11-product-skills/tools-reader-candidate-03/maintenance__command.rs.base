//! Read-only canonical checks and bounded skill evaluation profiles.
use crate::maintenance::{
    evaluation, inventory, language, package, paired, product, routing, selected_inputs, sessions,
};

use std::{env, path::Path, process::ExitCode};

fn run(args: &[String]) -> Result<bool, Box<dyn std::error::Error>> {
    match args.first().map(String::as_str) {
        Some("local-skill-eval") if args.len() == 4 => {
            crate::maintenance::local_eval::run(Path::new(&args[1]), Path::new(&args[2]), args[3].parse()?, false)?;
            Ok(true)
        }
        Some("local-skill-exposure-eval") if args.len() == 4 => {
            crate::maintenance::local_eval::run(Path::new(&args[1]), Path::new(&args[2]), args[3].parse()?, true)?;
            Ok(true)
        }
        Some("evidence-layout-plan") if args.len() == 2 => {
            let receipt = crate::maintenance::evidence_layout::inspect_request_file(Path::new(&args[1]))?;
            let complete = receipt.command_budget_complete && receipt.plan.structurally_valid;
            println!("{}", serde_json::to_string_pretty(&receipt)?);
            Ok(complete)
        }
        Some("windows-doctor") if args.len() == 1 || (args.len() == 2 && args[1] == "--probe") => {
            println!("{}", serde_json::to_string_pretty(&crate::maintenance::windows_doctor::inspect(args.len() == 2))?);
            Ok(true)
        }
        Some("selected-inputs") if args.len() == 2 => {
            let receipt = selected_inputs::observe_request_file(Path::new(&args[1]))?;
            let complete = receipt.command_budget_complete
                && receipt.observation.content_read_complete
                && receipt.observation.input_selection_complete;
            println!("{}", serde_json::to_string_pretty(&receipt)?);
            Ok(complete)
        }
        Some("language-check-request") if args.len() == 2 => {
            let receipt = language::source::check_request_file(Path::new(&args[1]))?;
            let complete = receipt.qualified_complete;
            println!("{}", serde_json::to_string_pretty(&receipt)?);
            Ok(complete)
        }
        Some("language-check") => Err(
            "language-check requires an explicit source contract; use language-check-request ABSOLUTE_REQUEST_JSON".into(),
        ),
        Some("paired-check") if args.len() == 2 || args.len() == 3 => {
            let path = Path::new(&args[1]);
            let metadata = std::fs::symlink_metadata(path)?;
            if metadata.file_type().is_symlink() || !metadata.is_file() || metadata.len() > 16 * 1024 * 1024 {
                return Err("unsafe/oversized paired result".into());
            }
            let value = serde_json::from_slice(&std::fs::read(path)?)?;
            let result = match args.get(2).map(String::as_str).unwrap_or("product") {
                "product" => paired::validate(&value),
                "developer" => paired::validate_developer(&value),
                _ => return Err("unknown paired suite; expected product or developer".into()),
            };
            println!("{}", serde_json::to_string_pretty(&result)?);
            Ok(result.errors.is_empty())
        }
        Some("check") if args.len() == 2 => {
            let result = inventory::check(Path::new(&args[1]))?;
            println!("{}", serde_json::to_string_pretty(&result)?);
            Ok(result.errors.is_empty())
        }
        Some("routing") if args.len() == 2 => {
            let result = routing::evaluate(Path::new(&args[1]))?;
            println!("{}", serde_json::to_string_pretty(&result)?);
            Ok(result.failed == 0)
        }
        Some("product-content-check-request") if args.len() == 2 => {
            let receipt = product::selected::check_request_file(Path::new(&args[1]))?;
            let qualified = receipt.qualified_complete;
            println!("{}", serde_json::to_string_pretty(&receipt)?);
            Ok(qualified)
        }
        Some("lane-content-check-request") if args.len() == 2 => {
            let receipt = sessions::catalog::selected::check_request_file(Path::new(&args[1]))?;
            let qualified = receipt.qualified_complete;
            println!("{}", serde_json::to_string_pretty(&receipt)?);
            Ok(qualified)
        }
        Some("thread-content-check-request") if args.len() == 2 => {
            let receipt = sessions::registry::selected::check_request_file(Path::new(&args[1]))?;
            let qualified = receipt.qualified_complete;
            println!("{}", serde_json::to_string_pretty(&receipt)?);
            Ok(qualified)
        }
        Some("skill-check" | "lane-check" | "thread-check") => Err(
            "explicit source request required; select product/lane/thread-content-check-request ABSOLUTE_REQUEST_JSON".into(),
        ),
        Some("session-list") if args.len() == 2 => {
            println!("{}",serde_json::to_string_pretty(&sessions::storage::list(Path::new(&args[1]))?)?);Ok(true)
        }
        Some("session-claim") if args.len() == 3 => {
            let claim=sessions::storage::claim_request_file(Path::new(&args[1]),Path::new(&args[2]))?;
            println!("{}",serde_json::json!({"schema":"humanymous.session-claim.v1","claim":claim,"runtime_qualified":false}));Ok(true)
        }
        Some("session-release") if args.len() == 6 => {
            sessions::storage::release(Path::new(&args[1]),&args[2],&args[3],&args[4],&args[5])?;
            println!("{}",serde_json::json!({"schema":"humanymous.session-release.v1","released":true,"runtime_qualified":false}));Ok(true)
        }
        Some("stage-eval") if args.len() == 4 => {
            let receipt=package::stage(Path::new(&args[1]),Path::new(&args[2]),&args[3])?;
            println!("{}",serde_json::to_string_pretty(&receipt)?);Ok(true)
        }
        Some("observe-skills") if args.len() == 2 => {
            println!(
                "{}",
                serde_json::to_string_pretty(&inventory::external(Path::new(&args[1]))?)?
            );
            Ok(true)
        }
        Some("normalize") if args.len() == 2 => {
            println!(
                "{}",
                serde_json::to_string_pretty(&inventory::normalize(Path::new(&args[1]))?)?
            );
            Ok(true)
        }
        Some("eval") if args.len() == 5 => evaluation::run(
            Path::new(&args[1]),
            Path::new(&args[2]),
            Path::new(&args[3]),
            &args[4],
        ),
        _ => Err(
            "usage: agent-maintenance evidence-layout-plan REQUEST_JSON | windows-doctor [--probe] | selected-inputs REQUEST_JSON | paired-check RESULT_JSON [product|developer] | language-check-request ABSOLUTE_REQUEST_JSON | check ROOT | routing ROOT | product-content-check-request ABSOLUTE_REQUEST_JSON | thread-content-check-request ABSOLUTE_REQUEST_JSON | lane-content-check-request ABSOLUTE_REQUEST_JSON | session-list ROOT | session-claim ROOT REQUEST_JSON_FILE | session-release ROOT LANE PROVIDER SESSION NOTE | stage-eval ROOT NEW_OUTPUT product|developer | normalize ROOT | observe-skills PATH | eval ROOT CLI NEW_OUTPUT SUITE"
                .into(),
        ),
    }
}

pub(super) fn main() -> ExitCode {
    match run(&env::args().skip(1).collect::<Vec<_>>()) {
        Ok(true) => ExitCode::SUCCESS,
        Ok(false) => ExitCode::FAILURE,
        Err(error) => {
            eprintln!("{error}");
            ExitCode::from(2)
        }
    }
}
