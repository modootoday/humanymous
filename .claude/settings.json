{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agents/hooks/pre-tool-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'R=fde47840d02fe81976d60d668f7fa08ee0211d24; B=\"$(command -v playpilot || echo \"$HOME/.cargo/bin/playpilot\")\"; D=\"$(dirname \"$(dirname \"$B\")\")\"; if [ \"$(cat \"$D/share/playpilot.rev\" 2>/dev/null)\" != \"$R\" ]; then for c in cargo /root/.cargo/bin/cargo \"$HOME/.cargo/bin/cargo\"; do command -v \"$c\" >/dev/null 2>&1 && \"$c\" install --force --locked --quiet --git https://github.com/modootoday/playpilot --rev \"$R\" --root \"$D\" playpilot >&2 && mkdir -p \"$D/share\" && echo \"$R\" > \"$D/share/playpilot.rev\" && break; done; fi; [ -x \"$B\" ] || { echo \"playpilot CLI is missing and could not be installed\" >&2; exit 2; }; PLAYPILOT_PROTECTED_BRANCHES=main,codex/rust exec \"$B\" guard'",
            "timeout": 240
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo run --locked --manifest-path scripts/ci/*)",
      "Bash(cargo run --locked --manifest-path skills/agent-maintenance/Cargo.toml *)",
      "Bash(cargo run -q --locked --manifest-path scripts/ci/*)",
      "Bash(cargo run -q --locked --manifest-path skills/agent-maintenance/Cargo.toml *)",
      "Bash(spec check *)",
      "Bash(spec check)",
      "Bash(spec context *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git checkout -b claude/*)",
      "Bash(git checkout -B claude/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git cherry-pick *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(gh api -X GET *)",
      "Bash(playpilot mail inbox *)",
      "Bash(playpilot sync --check *)",
      "Bash(playpilot history-check *)",
      "Bash(playpilot surface-check *)",
      "Bash(playpilot validate *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh ruleset *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh workflow run *)",
      "Bash(gh api -X PUT *)",
      "Bash(gh api -X PATCH *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method PUT *)",
      "Bash(gh api --method PATCH *)",
      "Bash(gh api --method DELETE *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push --tags *)",
      "Bash(git push * --tags)",
      "Bash(git tag *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git push origin codex/rust *)",
      "Bash(git push origin codex/rust)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "mcp__github__merge_pull_request",
      "mcp__github__pull_request_review_write",
      "mcp__github__create_repository",
      "mcp__github__delete_file",
      "mcp__github__fork_repository"
    ]
  }
}
