{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanymous:adapter:0.1:response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "tenant",
    "origin",
    "revision",
    "expires",
    "verdict"
  ],
  "properties": {
    "protocol": {
      "const": "humanymous.adapter/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "origin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "expires": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "verdict": {
      "enum": [
        "ALLOW",
        "DENY",
        "CHALLENGE"
      ]
    }
  }
}
