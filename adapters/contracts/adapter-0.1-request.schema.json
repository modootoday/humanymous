{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humanymous:adapter:0.1:request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "tenant",
    "origin",
    "revision",
    "deadline",
    "method",
    "target",
    "authority",
    "peer",
    "headers",
    "headerMode",
    "body",
    "capabilities",
    "stream",
    "adapter",
    "connectionId",
    "capture"
  ],
  "properties": {
    "protocol": {
      "const": "humanymous.adapter/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "origin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "deadline": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "method": {
      "type": "string",
      "pattern": "^[A-Z!#$%&\\x27*+.^_`|~0-9-]{1,32}$"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "authority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "peer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "headers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[!#$%&\\x27*+.^_`|~0-9A-Za-z-]+$"
          },
          {
            "type": "string",
            "pattern": "^[^\\r\\n\\u0000]*$"
          }
        ],
        "items": false
      }
    },
    "headerMode": {
      "enum": [
        "node-raw",
        "fetch-normalized"
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "complete",
        "length",
        "sha256",
        "base64"
      ],
      "properties": {
        "layer": {
          "const": "transfer-decoded-content-encoded"
        },
        "complete": {
          "const": true
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawTls",
        "originalH2",
        "rawHeaderOrder",
        "completeBody"
      ],
      "properties": {
        "rawTls": {
          "const": false
        },
        "originalH2": {
          "const": false
        },
        "rawHeaderOrder": {
          "type": "boolean"
        },
        "completeBody": {
          "const": true
        }
      }
    },
    "stream": {
      "const": null
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "installation"
      ],
      "properties": {
        "id": {
          "const": "humanymous.node"
        },
        "version": {
          "const": "0.1.0-experimental.1"
        },
        "installation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      }
    },
    "connectionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capture": {
      "const": null
    }
  }
}
