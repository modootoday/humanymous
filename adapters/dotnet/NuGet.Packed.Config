<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="owned-candidate" value="%HUMANYMOUS_NUGET_FEED%" />
    <add key="upstream-sdk" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="owned-candidate">
      <package pattern="Humanymous.Native.Experimental" />
    </packageSource>
    <packageSource key="upstream-sdk">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="runtime.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
