<Project>
  <PropertyGroup>
    <HumanymousBuildRoot Condition="'$(HumanymousBuildRoot)' == ''">$(MSBuildThisFileDirectory)../../target/dotnet</HumanymousBuildRoot>
    <BaseIntermediateOutputPath>$(HumanymousBuildRoot)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(HumanymousBuildRoot)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <NuGetLockFilePath>$(BaseIntermediateOutputPath)packages.lock.json</NuGetLockFilePath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
