# Component/authority host lifecycle acceptance only; full product lab is separate.
FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS node
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS bun
FROM rust:1.99.1-slim-bookworm@sha256:f2c004e3d2d8b547e8cf7ffbc29205385f4e71d23e53e4e383065db5e9f822cd
ENV CARGO_BUILD_JOBS=1
ENV CARGO_INCREMENTAL=0
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /source
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ ./crates/
COPY docs/tooling/ ./docs/tooling/
COPY test/lab/runner/ ./test/lab/runner/
COPY test/lab/runtime/ ./test/lab/runtime/
COPY scripts/ci/delivery/ ./scripts/ci/delivery/
COPY skills/agent-maintenance/ ./skills/agent-maintenance/
COPY adapters/node/package.json adapters/node/package-lock.json ./adapters/node/
RUN node /usr/local/lib/node_modules/npm/bin/npm-cli.js ci --ignore-scripts --prefix adapters/node
RUN cargo build --locked -p humanymous-runtime --features authority --bin humanymous-authority
RUN cargo build --locked -p humanymous-node-adapter --features host-pilot --bin humanymous-node-package
RUN node /usr/local/lib/node_modules/npm/bin/npm-cli.js exec --prefix adapters/node -- napi build --manifest-path crates/node-adapter/Cargo.toml --package-json-path adapters/node/package.json --platform --output-dir target/node-native/host-glue --js index.cjs --dts index.d.cts --format commonjs --features host-pilot -- --locked
RUN cargo test --locked -p humanymous-node-adapter --features host-pilot --test host_process --no-run
ENV HUMANYMOUS_NODE_ADDON=/source/target/node-native/host-glue/humanymous-node.linux-x64-gnu.node
ENV HUMANYMOUS_BUN_PRELOAD=/source/target/node-native/host-glue/index.cjs
ENV HUMANYMOUS_AUTHORITY_BIN=/source/target/debug/humanymous-authority
ENV CARGO_NET_OFFLINE=true
USER 65532:65532
# Runtime invocation additionally requires --network none and bounded resources.
CMD ["/source/target/debug/humanymous-node-package", "run-host-tests"]
