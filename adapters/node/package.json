{
  "name": "@humanymous/node",
  "version": "0.1.0-experimental.1",
  "description": "Experimental Node stream and Fetch bridge to the Rust authority",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.cjs",
  "types": "./src/index.d.cts",
  "exports": {
    ".": {
      "import": { "types": "./src/index.d.mts", "default": "./src/index.mjs" },
      "require": { "types": "./src/index.d.cts", "default": "./src/index.cjs" }
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "capabilities.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modootoday/humanymous.git",
    "directory": "adapters/node"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:bun": "bun test/pilot.mjs",
    "typecheck": "tsc --noEmit --strict --types node --module nodenext --moduleResolution nodenext test/types.mts test/types.cts",
    "check:package": "node test/package.mjs",
    "prepack": "npm run typecheck && npm run check:package",
    "test:pilot": "node test/pilot.mjs"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.6",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "express": "5.3.0",
    "hono": "4.13.16",
    "typescript": "7.0.2"
  }
}
