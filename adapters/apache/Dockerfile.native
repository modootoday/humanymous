# syntax=docker/dockerfile:1.7
# Hosted-only ABI build candidate. No successful build/pilot receipt exists yet.
FROM rust:1.99.1-bookworm@sha256:e6f2cff35d0f309acf8433b4f05878ed77092602c5065cc81801177da0bb3a9c AS build
RUN apt-get update
RUN apt-get install -y --no-install-recommends clang-14 libclang-14-dev libpcre2-dev libexpat1-dev ca-certificates make
ADD --checksum=sha256:e0cc26ab60a024db2b4a9b219ce6e1538fe2d3138ece2156d2834c63ae21913d https://downloads.apache.org/httpd/httpd-2.4.70.tar.gz /tmp/httpd.tar.gz
ADD --checksum=sha256:6a10e7f7430510600af25fabf466e1df61aaae910bf1dc5d10c44a4433ccc81d https://downloads.apache.org/apr/apr-1.7.6.tar.gz /tmp/apr.tar.gz
ADD --checksum=sha256:acd5f38440eda830e40c4fe35c2a6b8119493cfdba9c9d73d985c317beb4e4f8 https://downloads.apache.org/apr/apr-util-1.6.6.tar.gz /tmp/apr-util.tar.gz
RUN tar -xzf /tmp/httpd.tar.gz -C /opt
RUN mkdir /opt/httpd-2.4.70/srclib/apr /opt/httpd-2.4.70/srclib/apr-util
RUN tar -xzf /tmp/apr.tar.gz --strip-components=1 -C /opt/httpd-2.4.70/srclib/apr
RUN tar -xzf /tmp/apr-util.tar.gz --strip-components=1 -C /opt/httpd-2.4.70/srclib/apr-util
WORKDIR /opt/httpd-2.4.70
# Invoke unchanged upstream build tooling; no authored C or executable host glue.
RUN ./configure --prefix=/opt/httpd --with-included-apr --enable-so --enable-mods-shared=most --enable-mpms-shared=all --with-mpm=event --enable-proxy --enable-proxy-http --disable-ssl --disable-http2
RUN make -j2
RUN make install
WORKDIR /src
COPY . /src
ENV CARGO_BUILD_JOBS=1
ENV CARGO_INCREMENTAL=0
ENV RUSTUP_TOOLCHAIN=1.99.1
ENV HUMANYMOUS_HTTPD_INCLUDE=/opt/httpd/include
ENV HUMANYMOUS_APR_INCLUDE=/opt/httpd/include
ENV HUMANYMOUS_APU_INCLUDE=/opt/httpd/include
ENV HUMANYMOUS_CLANG_LIBRARY=/usr/lib/llvm-14/lib/libclang.so.1
ENV LIBCLANG_PATH=/usr/lib/llvm-14/lib/libclang.so.1
RUN rustup component add clippy --toolchain 1.99.1
RUN cargo test --locked -p humanymous-apache-adapter --lib
RUN cargo clippy --locked -p humanymous-apache-adapter --all-targets -- -D warnings
# Native package registration is owned by root and is a prerequisite for these.
RUN cargo build --locked --release -p humanymous-apache-native --features httpd --lib
RUN cargo clippy --locked -p humanymous-apache-native --features httpd --lib -- -D warnings
RUN install -D /src/target/release/libhumanymous_apache_native.so /opt/httpd/modules/libhumanymous_apache_native.so
RUN cargo build --locked --release -p humanymous-apache-native --features httpd,pilot-probes --lib
RUN cargo clippy --locked -p humanymous-apache-native --features httpd,pilot-probes --lib -- -D warnings
RUN install -D /src/target/release/libhumanymous_apache_native.so /opt/httpd/modules/libhumanymous_apache_probe.so
RUN cargo build --locked --release -p humanymous-apache-native --features pilot --bin humanymous-apache-pilot
RUN cargo clippy --locked -p humanymous-apache-native --features pilot --bin humanymous-apache-pilot -- -D warnings
RUN install -D /src/target/release/humanymous-apache-pilot /out/pilot

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS native-candidate
RUN apt-get update
RUN apt-get install -y --no-install-recommends libpcre2-8-0 libexpat1 libgcc-s1
COPY --from=build /opt/httpd /opt/httpd
USER 65532:65532
# Lab must supply its owned configuration and run in an isolated network-none
# container. This entrypoint is a server build candidate, not a pilot success.
ENTRYPOINT ["/opt/httpd/bin/httpd", "-DFOREGROUND"]

FROM native-candidate AS pilot
COPY --from=build /out/pilot /opt/apache-pilot
ENV HUMANYMOUS_APACHE_OWNED_DOCKER=1
ENTRYPOINT ["/opt/apache-pilot"]
