# Copy to a private local .env for this adapter only. Never commit secrets.
# Project name must stay under humanymous-apache-* (not humanymous-pages-preview).
HUMANYMOUS_APACHE_IMAGE=humanymous-apache-native:local
HUMANYMOUS_SOURCE_REV=REPLACE_WITH_EXACT_CHECKOUT_SHA
HUMANYMOUS_SOURCE_MANIFEST_SHA256=REPLACE_WITH_FROZEN_SOURCE_MANIFEST_SHA256
