{
  "manifest_version": 3,
  "name": "humanymous external-input DOM observer",
  "version": "1.0.0",
  "description": "Read-only, fixed-fixture observer for the SoT-41 defensive Docker pilot.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://core/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://core/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
