# humanymous Gate — systemd unit for running the binary directly on a host
# (no container). Mirrors deployments/compose.release.yaml's flags and hardening.
#
# Install: see README.md in this directory (build with `make gate`, create the
# `humanymous` user, write /etc/humanymous/gate.env, then enable this unit).
[Unit]
Description=humanymous Gate — reverse-proxy bot-detection edge
Documentation=https://github.com/modootoday/humanymous
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=humanymous
Group=humanymous

# HMN_UNSEAL (keystore seal passphrase) + HMN_ADMIN_TOKENS (real role:token
# pairs; the binary refuses the e2e-* dev tokens). Keep this file root:humanymous
# 0640 — it holds secrets.
EnvironmentFile=/etc/humanymous/gate.env

# Public edge on :8444 (front it with :443, e.g. via an ACME domain or a TLS LB).
# Admin plane bound to LOOPBACK only — reachable off-host solely via SSH/mTLS.
# Keystore + audit WAL live under the unit's single writable dir.
ExecStart=/usr/local/bin/gate \
    -addr :8444 \
    -admin-addr 127.0.0.1:8445 \
    -upstream http://127.0.0.1:8080 \
    -keystore /var/lib/humanymous/keystore \
    -audit-wal /var/lib/humanymous/audit

Restart=on-failure
RestartSec=2s

# >= gate -shutdown-grace (default 25s) so the SIGTERM drain completes before
# systemd sends SIGKILL.
TimeoutStopSec=30

# --- Sandbox hardening ---
NoNewPrivileges=true
ProtectSystem=strict            # entire fs read-only except ReadWritePaths below
ProtectHome=true
PrivateTmp=true                 # private /tmp, /var/tmp
ReadWritePaths=/var/lib/humanymous
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Binding :8444 (unprivileged) needs no extra caps. If you switch -addr to :443,
# grant the capability instead of running as root:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
