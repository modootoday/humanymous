# humanymous Gate adopter config (SoT-31 R7). Copy to `.env` and edit.
# `compose -f compose.release.yaml` reads this for ${...} substitution.

# Image version to pull (a semver tag from ghcr.io, or `latest`). Pin in prod.
HMN_VERSION=latest

# Your origin app's base URL, reachable on the origin network below.
HMN_UPSTREAM=http://app:8080

# The public domain Gate serves. Used for a Let's Encrypt cert (TLS-ALPN-01,
# needs port 443 reachable). For bring-your-own TLS instead, drop -acme-domain
# from the command, mount your cert, and add -tls-cert/-tls-key.
HMN_DOMAIN=example.com

# The EXISTING docker network your origin runs on (Gate joins it).
# Create one with: docker network create humanymous-origin
HMN_ORIGIN_NET=humanymous-origin

# Admin bearer tokens — role:token pairs. Generate real random values; the binary
# REFUSES to boot on the shipped e2e-* dev tokens (SoT-31 R3). Do NOT set
# HMN_ALLOW_DEV_TOKENS in production.
HMN_ADMIN_TOKENS=auditor:CHANGE-ME-auditor,operator:CHANGE-ME-operator,approver:CHANGE-ME-approver,dpo:CHANGE-ME-dpo

# Passphrase that seals the persistent audit/keystore identity across restarts
# (so a reboot does not crypto-shred pseudonym linkage). Keep it secret.
HMN_UNSEAL=CHANGE-ME-a-long-random-passphrase
