# humanymous runtime adopter config (SoT-31 R7). Copy to `.env` and edit.
# `compose -f compose.release.yaml` reads this for ${...} substitution.
#
# Secrets do NOT go here. The Rust runtime reads no environment: its custody
# unseal passphrase lives in runtime.json, which you pipe to its stdin. The Go
# Gate's HMN_UPSTREAM, HMN_DOMAIN, HMN_ADMIN_TOKENS and HMN_UNSEAL are gone:
# the origin is `origin` in runtime.json, TLS belongs to the edge, there is no
# admin plane, and the passphrase is `audit.keys.passphrase`.

# Runtime image version to pull (a semver tag from ghcr.io, or `latest`). Pin in prod.
HMN_VERSION=latest

# Your TLS front proxy image. compose.release.yaml refuses to start without it.
HMN_EDGE_IMAGE=registry.example.invalid/your-tls-edge:REPLACE-ME

# The EXISTING docker network your origin runs on (the edge joins it).
# Create one with: docker network create humanymous-origin
HMN_ORIGIN_NET=humanymous-origin
