# Dev-only configuration for the local Docker stack (NOT for production).
# Loaded by the compose services via `env_file`. Production issues admin
# credentials via mTLS/SSO and mints secrets out-of-band — never ship these.

# Deterministic Gate admin tokens (the conformance e2e mirrors these).
HMN_ADMIN_TOKENS=auditor:e2e-auditor-token,operator:e2e-operator-token,approver:e2e-approver-token,dpo:e2e-dpo-token
# Explicitly permit the shipped e2e-* dev tokens (SoT-31 R3). Production must NOT
# set this — the binary refuses to boot on e2e-* tokens without it.
HMN_ALLOW_DEV_TOKENS=1

# Core operator endpoint token used only by the Docker red/blue catalog. The
# watermark-strip profile authenticates before asking /api/trace to identify a leak.
HMN_OPS_TOKEN=e2e-core-operator-token

# Automation catalog default target (the detector engine on the internal lab network) + runs.
HM_BASE=https://core:8443
HM_RUNS=1

# Shared fingerprint the multi-subnet Red swarm carries from distinct subnets so
# the engine's cross-session correlation sees one identity across real subnets.
HM_FP=swarm-shared-fp-0001
HM_SWARM_N=5
